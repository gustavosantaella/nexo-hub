# Entorno
NODE_ENV=development
PORT=3000
API_PREFIX=api

# Base de datos
# Desarrollo (SQLite):
DATABASE_URL="file:./dev.db"
# Produccion (PostgreSQL) - cambia tambien el provider en prisma/schema.prisma:
# DATABASE_URL="postgresql://usuario:password@localhost:5432/nexo_hub?schema=public"

# JWT
JWT_SECRET="cambia-este-secreto-en-produccion"
JWT_EXPIRES_IN="12h"

# CORS
CORS_ORIGINS="http://localhost:4200,http://localhost:5173"

# Caja
CASH_SINGLE_OPEN_SESSION=true

# Tasas de cambio
# Endpoint publico del BCV (dolarvzla) con la tasa oficial del dia.
RATES_BCV_URL="https://rates.dolarvzla.com/bcv/current.json"
# Segundos que se reutiliza la respuesta del BCV antes de volver a consultarla.
RATES_CACHE_TTL_SECONDS=900
# Tiempo maximo de espera de las consultas externas (ms).
RATES_TIMEOUT_MS=8000
# Tasa USDT/VES de referencia (Binance P2P). Es SOLO informativa: se muestra en
# /configuracion y no se usa para convertir montos.
RATES_USDT_URL="https://fx.vexwallet.co/api/v1/fx/latest?pair=USDT/VES&source=binance&method=p2p_floor"
RATES_USDT_CACHE_TTL_SECONDS=300
