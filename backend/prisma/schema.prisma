// ---------------------------------------------------------------------------
// Nexo Hub - Esquema de base de datos (Prisma)
// ---------------------------------------------------------------------------
// NOTA IMPORTANTE:
//   - Se usa SQLite en desarrollo para poder ejecutar el proyecto sin instalar
//     ningun motor de base de datos. Para produccion cambia:
//         provider = "postgresql"  (o "mysql")
//     y apunta DATABASE_URL a tu servidor. Prisma migrara los tipos.
//   - Los "enums" se representan como String porque SQLite no soporta enums
//     nativos. Los valores validos viven en src/common/constants/enums.ts.
//   - El dinero se guarda como ENTERO de centavos (columnas `Int`), nunca como
//     decimal: asi no existe deriva de punto flotante al sumar o agrupar. La
//     conversion decimal <-> centavos ocurre solo en la frontera de Prisma
//     (src/common/utils/money-codec.ts), de modo que los servicios, los DTOs,
//     la API y el frontend siguen hablando de decimales (`194.34`).
//     Las tasas de cambio (`exchangeRate`, `openingRate`, `countedRate`) siguen
//     siendo Float porque no son montos.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================== Empresas ===================================
// El sistema es multi-empresa: TODO registro de dominio pertenece a una
// empresa (`companyId`) y los datos de una empresa nunca se mezclan con los
// de otra. El rol NO es del usuario sino de su membresia: un mismo usuario
// puede ser ADMIN en una empresa y CASHIER en otra.
model Company {
  id        String   @id @default(cuid())
  name      String
  rif       String   @unique // RIF / identificacion fiscal de la empresa
  phone     String?
  email     String?
  address   String?
  notes     String?
  // Logo que se imprime en los reportes: URL publica o data URL (base64) del
  // archivo, que el navegador ya reduce antes de guardarlo (ver utils/image.ts).
  logoUrl   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships        Membership[]
  settings           Setting[]
  preferences        CompanyPreference?
  categories         Category[]
  suppliers          Supplier[]
  customers          Customer[]
  products           Product[]
  menuCategories     MenuCategory[]
  menus              Menu[]
  menuIngredients    MenuIngredient[]
  stockMovements     StockMovement[]
  orders             Order[]
  orderItems         OrderItem[]
  orderPayments      OrderPayment[]
  expenses           Expense[]
  payables           AccountPayable[]
  payablePayments    PayablePayment[]
  receivables        AccountReceivable[]
  receivablePayments ReceivablePayment[]
  cashSessions       CashSession[]
  cashMovements      CashMovement[]
  notificationSettings NotificationSetting?
  cancellationOtps   CancellationOtp[]

  @@index([name])
  @@map("companies")
}

// Rol (y estado) de un usuario DENTRO de una empresa concreta.
model Membership {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  role      String   @default("CASHIER") // ADMIN | MANAGER | CASHIER
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId])
  @@index([userId])
  @@map("memberships")
}

// ============================== Seguridad ==================================
// Identidad global: la misma cuenta (email/contrasena) puede pertenecer a
// varias empresas a traves de `Membership`. El rol vive en la membresia.

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  documentId   String? // cedula / documento de identidad
  passwordHash String
  phone        String? // telefono de contacto
  avatarUrl    String?
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  memberships        Membership[]
  cashSessionsOpened CashSession[]       @relation("CashSessionOpenedBy")
  cashSessionsClosed CashSession[]       @relation("CashSessionClosedBy")
  cashMovements      CashMovement[]
  orders             Order[]             @relation("OrderCreatedBy")
  stockMovements     StockMovement[]
  expenses           Expense[]
  payables           AccountPayable[]
  receivablePayments ReceivablePayment[]
  payablePayments    PayablePayment[]
  settingsUpdated    Setting[]           @relation("SettingUpdatedBy")

  @@map("users")
}

// Preferencias de INTERFAZ de la empresa (Configuracion): la propina que el
// punto de venta propone al cobrar, la moneda/tasas con las que el cajero ve los
// precios, la tasa del dolar con la que cobra y la presentacion de los formularios
// de caja y pedidos. Es una sola fila por empresa, compartida por todo su personal:
// el cajero que entra desde otro navegador la recibe al iniciar sesion. `null` en
// una columna significa "sin configurar": la interfaz usa entonces su valor de
// fabrica (10 % de propina, moneda base del sistema y formularios en ventana modal).
model CompanyPreference {
  companyId     String   @id
  tipPercent    Float? // Propina sugerida (%) que el punto de venta propone al cobrar
  dialogView    String? // modal | sidebar: como se abren los formularios de caja/pedidos
  priceCurrency String? // Moneda (ISO, ej. VES) en la que el cajero ve los precios; null = moneda base
  conversionCurrencies String? // JSON con las monedas (ISO, ej. ["USD","COP"]) cuyas conversiones ve el cajero; null = ninguna
  showBcvPrice  Boolean? // Mostrar debajo de cada monto el precio en dolares a la tasa oficial del BCV; null = no
  chargeRateKey String? // Tasa del dolar con la que el cajero cobra (`BCV_USD` o `CUSTOM_USD`); null = la activa
  posView       String? // cards | table | columns: como lista el catalogo el punto de venta; null = cards
  updatedAt     DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("company_preferences")
}

// ============================== Catalogo ===================================

// Categoria de productos. Puede ser una categoria PRINCIPAL o una SUBCATEGORIA
// (`parentId`): como maximo dos niveles y la subcategoria es OPCIONAL, tanto
// para la categoria (no esta obligada a tener hijas) como para el producto (se
// puede agrupar en la principal o en una subcategoria concreta).
model Category {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  description String?
  // Categoria principal a la que pertenece (`null` = es una principal).
  parentId    String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company       Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // Al eliminar la principal sus subcategorias no se borran: pasan a ser
  // principales (SetNull), igual que los productos quedan sin categoria.
  parent        Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  subcategories Category[] @relation("CategoryHierarchy")
  products      Product[]

  @@unique([companyId, name])
  @@index([companyId])
  @@index([parentId])
  @@map("categories")
}

model Supplier {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  contactName String?
  phone       String?
  email       String?
  address     String?
  taxId       String?
  notes       String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company  Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products Product[]
  payables AccountPayable[]
  expenses Expense[]

  @@index([companyId])
  @@index([name])
  @@map("suppliers")
}

model Customer {
  id        String   @id @default(cuid())
  companyId String
  name      String
  phone     String?
  email     String?
  address   String?
  docNumber String?
  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company     Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  orders      Order[]
  receivables AccountReceivable[]

  @@index([companyId])
  @@index([name])
  @@map("customers")
}

model Product {
  id          String   @id @default(cuid())
  companyId   String
  sku         String
  name        String
  description String?
  // Foto que el cajero ve en la grilla del POS (punto de venta): URL publica o
  // data URL (base64) ya reducida por el navegador (ver frontend utils/image.ts).
  imageUrl    String?
  price       Int      @default(0)
  cost        Int      @default(0)
  // ---------------------------------------------------------------------------
  // CONTEXTO DE MONEDA DE LOS PRECIOS.
  // `price`, `cost`, `unitPrice` y `unitCost` SIEMPRE se guardan en dolares
  // (moneda base contable del sistema), pero el usuario puede escribir el
  // precio/costo en la
  // moneda que quiera y al cambio que quiera. Estas columnas recuerdan en que
  // moneda lo escribio (`priceCurrency`), cuanto escribio (`priceEntered`,
  // centavos de ESA moneda), la tasa aplicada (`priceRate` = bolivares por 1
  // unidad de esa moneda) y CUAL de las tasas del sistema uso
  // (`priceRateKey`: BCV_USD, BCV_EUR o CUSTOM_USD). Con las cuatro se
  // reconstruye la conversion exacta aunque el valor quede en USD.
  // ---------------------------------------------------------------------------
  priceCurrency   String @default("USD")
  priceRate       Float?
  priceRateKey    String?
  priceEntered    Int?
  costCurrency    String @default("USD")
  costRate        Float?
  costRateKey     String?
  costEntered     Int?
  // PRECIO DE VENTA de UNA unidad individual cuando el producto se vende por
  // presentacion (caja, paquete, six-pack): `price` es el de la presentacion
  // completa y `unitPrice` el de la unidad suelta (los dos SIEMPRE en USD). Tiene
  // su PROPIA moneda (`unitPriceCurrency`) y tasa (`unitPriceRate` /
  // `unitPriceRateKey`), igual que el resto de montos del catalogo. Con
  // `unitPrice = 0` (sin definir) la interfaz reparte `price / unitsPerBox`, para
  // que los productos anteriores a esta columna sigan vendiendose igual.
  unitPrice         Int    @default(0)
  unitPriceEntered  Int?
  unitPriceCurrency String @default("USD")
  unitPriceRate     Float?
  unitPriceRateKey  String?
  // Costo de UNA unidad individual cuando se compra por presentacion (caja,
  // paquete, six-pack): `cost` es el de la presentacion completa y `unitCost` el
  // de la unidad suelta (los dos SIEMPRE en USD). El costo unitario tiene su
  // PROPIA moneda (`unitCostCurrency`: no sigue a `costCurrency` porque el
  // operador elige una moneda por campo): `unitCostEntered` es lo que escribio en
  // esa moneda, `unitCostRate` la tasa aplicada y `unitCostRateKey` la tasa
  // elegida (igual que el precio y el costo de la presentacion).
  unitCost        Int    @default(0)
  unitCostEntered Int?
  unitCostCurrency String @default("USD")
  unitCostRate    Float?
  unitCostRateKey String?
  // Existencias en la unidad del producto. Es decimal (`Float`) porque las
  // recetas consumen fracciones: 100 g de un producto que se controla en kilos
  // son 0.1. El redondeo a 3 decimales ocurre en el motor de inventario, que es
  // el unico punto autorizado para variar el stock.
  stock       Float    @default(0)
  minStock    Float    @default(0)
  unit        String   @default("UND") // UND | KG | LT | CAJA | PAQUETE
  // Unidades individuales que trae la presentacion (caja/paquete). El `price`
  // sigue siendo el de la presentacion completa y el stock se lleva en unidades
  // individuales: el POS vende sueltas a `unitPrice` y, si esta sin definir (0),
  // a `price / unitsPerBox`. 1 = suelto.
  unitsPerBox Int      @default(1)
  trackStock  Boolean  @default(true)
  active      Boolean  @default(true)
  categoryId  String?
  supplierId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company    Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category   Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  supplier   Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  movements  StockMovement[]
  orderItems OrderItem[]
  menuIngredients MenuIngredient[]

  @@unique([companyId, sku])
  @@index([companyId])
  @@index([name])
  @@index([categoryId])
  @@index([supplierId])
  @@map("products")
}

// ============================== Inventario =================================

model StockMovement {
  id            String   @id @default(cuid())
  companyId     String
  productId     String
  type          String // IN | OUT | ADJUSTMENT
  // Cantidades en la unidad del producto (3 decimales): las recetas descuentan
  // fracciones (0.1 = 100 g). `quantity` es siempre positivo, la direccion la da
  // "type".
  quantity      Float
  stockBefore   Float
  stockAfter    Float
  // Como lo escribio el operador: `inputUnit` es la unidad con la que penso el
  // movimiento (CAJA, UND, KG, G, LT, ML) e `inputQuantity` la cantidad escrita
  // en ESA unidad. `quantity` (arriba) ya viene convertida a la unidad de stock
  // del producto, que es la unica que mueve el inventario.
  inputUnit     String?
  inputQuantity Float?
  unitCost      Int?
  // Contexto de moneda del costo unitario (mismo criterio que en Product):
  // `unitCost` queda en USD y estas columnas recuerdan lo que se escribio.
  unitCostCurrency String @default("USD")
  unitCostRate     Float?
  unitCostEntered  Int?
  reason        String?
  referenceType String? // ORDER | PURCHASE | MANUAL | ADJUSTMENT
  referenceId   String?
  createdById   String?
  createdAt     DateTime @default(now())

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdBy User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([productId])
  @@index([createdAt])
  @@map("stock_movements")
}

// ================================ Pedidos ==================================

model Order {
  id            String   @id @default(cuid())
  companyId     String
  code          String
  customerId    String?
  type          String   @default("DINE_IN") // DINE_IN | TAKEAWAY | DELIVERY
  status        String   @default("PENDING") // PENDING | CONFIRMED | PREPARING | READY | COMPLETED | CANCELLED
  tableNumber   String?
  notes         String?
  subtotal      Int      @default(0)
  discount      Int      @default(0)
  tax           Int      @default(0)
  tip           Int      @default(0) // Propina del cliente (no paga IGV)
  // ---------------------------------------------------------------------------
  // COSTO ADICIONAL POR DELIVERY (opcional).
  // Solo se usa en los pedidos a domicilio; `deliveryFee` va en USD como el resto
  // del dinero y, igual que la propina, NO paga IGV (se suma al final del total).
  // El contexto de moneda recuerda lo que escribio el operador para volver a
  // mostrarlo tal cual: `deliveryFeeEntered` (centavos de `deliveryFeeCurrency`),
  // la tasa aplicada (`deliveryFeeRate`, bolivares por 1 unidad de esa moneda) y
  // CUAL de las tasas del sistema eligio (`deliveryFeeRateKey`).
  // ---------------------------------------------------------------------------
  deliveryFee         Int      @default(0)
  deliveryFeeEntered  Int?
  deliveryFeeCurrency String   @default("USD")
  deliveryFeeRate     Float?
  deliveryFeeRateKey  String?
  // ---------------------------------------------------------------------------
  // PRECIOS TAL COMO LOS VIO EL CAJERO (snapshot de la vitrina).
  // Con la vitrina en bolivares y tasa personalizada el pedido se guarda en USD
  // al valor de venta (Bs de vitrina ÷ tasa BCV), que se redondea a centavos de
  // dolar. Volver a multiplicar ese USD por la tasa NO devuelve los bolivares
  // cobrados (16,00 USD -> Bs 15.520,00 se releian como Bs 15.521,27). Por eso el
  // pedido guarda ademas, congelados, los montos del ticket en `priceCurrency`:
  //   `priceCurrency`  moneda en la que el cajero vio los precios (null = base)
  //   `priceRate`      bolivares por 1 USD de esa vitrina
  //   `priceBreakdown` JSON en texto con subtotal/descuento/IGV/propina/delivery/
  //                    total en CENTAVOS de `priceCurrency` (ver `money-codec`).
  // Son solo para MOSTRAR: la contabilidad sigue usando los montos en USD.
  // `null` en pedidos sin recargo de vitrina o anteriores a estas columnas.
  // ---------------------------------------------------------------------------
  priceCurrency  String?
  priceRate      Float?
  priceBreakdown String?
  total         Int      @default(0)
  paidAmount    Int      @default(0)
  paymentStatus String   @default("UNPAID") // UNPAID | PARTIAL | PAID
  cashSessionId String?
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company     Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer    Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  cashSession CashSession?   @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)
  createdBy   User?          @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  items       OrderItem[]
  payments    OrderPayment[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([status])
  @@index([createdAt])
  @@index([cashSessionId])
  @@map("orders")
}

model OrderItem {
  id        String @id @default(cuid())
  companyId String
  orderId   String
  // Una linea vende un PRODUCTO suelto o un MENU (receta). Nunca ambos: el
  // servicio de pedidos lo valida al resolver las lineas.
  productId String?
  menuId    String?
  name      String // snapshot del nombre al momento de la venta
  quantity  Int
  unitPrice Int
  // PRECIO TAL COMO LO VIO EL CAJERO: `unitPrice` en `Order.priceCurrency`
  // (centavos). Se congela al vender para que el ticket repita el precio de
  // vitrina (Bs 8.000,00) y no el resultante de revalorar el USD ya redondeado
  // (Bs 8.049,02). `null` sin recargo de vitrina o en lineas anteriores.
  unitPriceEntered Int?
  total     Int
  // CONSUMO DE INVENTARIO CONGELADO al vender (JSON `[{productId, quantity}]`).
  // `quantity` es lo que consume UNA unidad de la linea (en un menu, su receta).
  // Al cancelar el pedido, quitar la linea o corregir la cantidad se devuelve
  // EXACTAMENTE lo que se desconto, aunque la receta del menu haya cambiado
  // despues de la venta. `null` = linea sin snapshot (producto suelto o pedido
  // anterior a esta columna): se resuelve con la receta vigente.
  consumption String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: Restrict)
  menu    Menu?    @relation(fields: [menuId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@index([orderId])
  @@index([menuId])
  @@map("order_items")
}

model OrderPayment {
  id             String   @id @default(cuid())
  companyId      String
  orderId        String
  amount         Int // Monto en la moneda del pago (`currency`)
  method         String // CASH | CARD | TRANSFER | YAPE | PLIN | MIXED
  currency       String   @default("USD") // Moneda en que pago el cliente
  exchangeRate   Float? // Bolivares por 1 unidad de `currency` (tasa usada)
  rateKey        String? // Tasa ELEGIDA para el cobro (BCV_USD | BCV_EUR | CUSTOM_USD); null = la activa del sistema
  // HISTORIAL DE TASAS del dia del cobro: JSON en texto con TODAS las tasas
  // vigentes al cobrar (BCV dolar, BCV euro y la personalizada del local), no
  // solo la aplicada. Asi un cobro viejo se puede auditar con las tasas que
  // existian ese dia aunque despues hayan cambiado. No es una columna de dinero
  // ni una tasa suelta (por eso no aparece en `money-columns.ts`).
  ratesHistory   String?
  baseAmount     Int      @default(0) // Equivalente en USD (moneda base del sistema)
  // DESGLOSE DEL COBRO (pagos mixtos): JSON en texto con cada parte que entrego
  // el cliente. Cada parte guarda metodo, moneda, monto, tasa aplicada y su
  // equivalente en USD. Vacio = cobro de una sola parte (columnas de arriba).
  parts            String?
  // VUELTO ENTREGADO: JSON en texto con cada forma en que se devolvio el cambio
  // (efectivo/transferencia/tarjeta y moneda). Se guarda aparte del pago porque
  // el vuelto puede darse en una moneda o metodo distinto al del cobro.
  change           String?
  // Total del vuelto en USD (moneda base), para consultas y reportes rapidos.
  changeBaseAmount Int      @default(0)
  // COMPROBANTE DE TRANSFERENCIA / PAGO MOVIL: referencia bancaria de 4 a 6
  // digitos y foto opcional del comprobante (data URL). Solo se guardan cuando
  // el cobro incluye un metodo que lo exige.
  paymentReference String?
  paymentPhotoUrl  String?
  cashMovementId String?  @unique
  note           String?
  createdById    String?
  createdAt      DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([orderId])
  @@map("order_payments")
}

// ================================= Menus ===================================
// El MENU es lo que se vende (plato, combo, "parrilla"): un producto elaborado
// a partir de una RECETA de ingredientes tomados del inventario. Vender un menu
// descuenta del stock cada ingrediente segun su cantidad (100 g de carne que se
// controla en kilos = 0.1).

// Agrupacion comercial del menu (Desayunos, Almuerzos, Combos, Postres). Es
// independiente de las categorias de productos: un menu se agrupa por como se
// vende, no por como se compra. Igual que las de productos, admite un nivel de
// SUBCATEGORIAS (`parentId`, opcional) para afinar la carta (Almuerzos >
// Sopas).
model MenuCategory {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  description String?
  // Color con el que el POS pinta la tarjeta/etiqueta del grupo (clase de
  // Tailwind o hex). Opcional: sin color usa el estilo por defecto.
  color       String?
  sortOrder   Int      @default(0)
  // Categoria principal a la que pertenece (`null` = es una principal).
  parentId    String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // Al eliminar la principal sus subcategorias pasan a ser principales (SetNull).
  parent        MenuCategory?  @relation("MenuCategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  subcategories MenuCategory[] @relation("MenuCategoryHierarchy")
  menus         Menu[]

  @@unique([companyId, name])
  @@index([companyId])
  @@index([sortOrder])
  @@index([parentId])
  @@map("menu_categories")
}

// Plato/combo vendible con su receta y su costo calculado.
model Menu {
  id          String   @id @default(cuid())
  companyId   String
  code        String // codigo legible unico por empresa (MEN-0001)
  name        String
  description String?
  imageUrl    String?
  price       Int      @default(0) // precio de venta (centavos, en USD)
  // Contexto de moneda del precio (mismo criterio que en Product): `price` queda
  // en USD y estas columnas recuerdan en que moneda lo escribio el usuario,
  // cuanto escribio (`priceEntered`) y con que tasa se convirtio (`priceRate`).
  priceCurrency String @default("USD")
  priceRate     Float?
  priceEntered  Int?
  // Costo de la receta (ingredientes x costo del producto). Se recalcula al
  // guardar y sirve para medir el margen sin abrir la ficha.
  cost        Int      @default(0)
  // Como se ofrece el menu en la carta: DINE_IN | TAKEAWAY | DELIVERY | ALL.
  availability String  @default("ALL")
  preparationMinutes Int? // tiempo estimado de preparacion (minutos)
  categoryId  String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category    MenuCategory?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  ingredients MenuIngredient[]
  orderItems  OrderItem[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([name])
  @@index([categoryId])
  @@map("menus")
}

// Linea de la receta: cuanto de un producto consume UNA unidad del menu.
// `quantity` esta en la MISMA unidad en la que se lleva el stock del producto
// (0.1 = 100 g si el producto se controla en kilos; 1 = una unidad).
model MenuIngredient {
  id        String  @id @default(cuid())
  companyId String
  menuId    String
  productId String
  quantity  Float   @default(0)
  // Como se ofrece dentro del menu: "Principal" | "Bebida" | "Postre" |
  // "Acompanamiento". Permite imprimir/ver el combo por secciones.
  section   String? @default("Principal")
  note      String?
  sortOrder Int     @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  menu    Menu    @relation(fields: [menuId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([menuId, productId])
  @@index([companyId])
  @@index([productId])
  @@map("menu_ingredients")
}

// =============================== Finanzas ==================================

model Expense {
  id            String   @id @default(cuid())
  companyId     String
  category      String // OPERATIVO | SERVICIOS | SUELDOS | COMPRAS | MANTENIMIENTO | IMPUESTOS | OTROS
  description   String
  amount        Int // Monto en la moneda del gasto (`currency`)
  currency      String   @default("USD") // Moneda en que se pago el gasto
  exchangeRate  Float? // Bolivares por 1 unidad de `currency` (tasa usada)
  baseAmount    Int      @default(0) // Equivalente en USD (moneda base del sistema)
  date          DateTime @default(now())
  paymentMethod String   @default("CASH") // CASH | CARD | TRANSFER | YAPE | PLIN | CREDIT
  supplierId    String?
  cashSessionId String?
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier    Supplier?    @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  createdBy   User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  cashSession CashSession? @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([date])
  @@index([category])
  @@index([cashSessionId])
  @@map("expenses")
}

model AccountPayable {
  id           String    @id @default(cuid())
  companyId    String
  supplierId   String?
  description  String
  amount       Int // Monto en la moneda de la cuenta (`currency`)
  currency     String    @default("USD") // Moneda en la que se registro la cuenta
  exchangeRate Float? // Bolivares por 1 unidad de `currency` (tasa usada)
  baseAmount   Int       @default(0) // Equivalente en USD (moneda base del sistema)
  paidAmount   Int       @default(0) // Abonado en USD (moneda base)
  dueDate      DateTime?
  status       String    @default("PENDING") // PENDING | PARTIAL | PAID | CANCELLED
  reference    String?
  notes        String?
  createdById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company   Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier  Supplier?        @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  createdBy User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  payments  PayablePayment[]

  @@index([companyId])
  @@index([status])
  @@map("accounts_payable")
}

model PayablePayment {
  id           String   @id @default(cuid())
  companyId    String
  payableId    String
  amount       Int // Monto en la moneda del pago (`currency`)
  method       String   @default("CASH")
  currency     String   @default("USD") // Moneda en que se pago la cuenta
  exchangeRate Float? // Bolivares por 1 unidad de `currency` (tasa usada)
  baseAmount   Int      @default(0) // Equivalente en USD (moneda base del sistema)
  note         String?
  createdById  String?
  createdAt    DateTime @default(now())

  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  payable   AccountPayable @relation(fields: [payableId], references: [id], onDelete: Cascade)
  createdBy User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([payableId])
  @@map("payable_payments")
}

model AccountReceivable {
  id           String    @id @default(cuid())
  companyId    String
  customerId   String?
  orderId      String?
  description  String
  amount       Int // Monto en la moneda de la cuenta (`currency`)
  currency     String    @default("USD") // Moneda en la que se registro la cuenta
  exchangeRate Float? // Bolivares por 1 unidad de `currency` (tasa usada)
  baseAmount   Int       @default(0) // Equivalente en USD (moneda base del sistema)
  paidAmount   Int       @default(0) // Cobrado en USD (moneda base)
  dueDate      DateTime?
  status       String    @default("PENDING") // PENDING | PARTIAL | PAID | CANCELLED
  reference    String?
  notes        String?
  createdById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company  Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  payments ReceivablePayment[]

  @@index([companyId])
  @@index([status])
  @@map("accounts_receivable")
}

model ReceivablePayment {
  id           String   @id @default(cuid())
  companyId    String
  receivableId String
  amount       Int // Monto en la moneda del pago (`currency`)
  method       String   @default("CASH")
  currency     String   @default("USD") // Moneda en que cobro el cliente
  exchangeRate Float? // Bolivares por 1 unidad de `currency` (tasa usada)
  baseAmount   Int      @default(0) // Equivalente en USD (moneda base del sistema)
  note         String?
  createdById  String?
  createdAt    DateTime @default(now())

  company    Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  receivable AccountReceivable @relation(fields: [receivableId], references: [id], onDelete: Cascade)
  createdBy  User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([receivableId])
  @@map("receivable_payments")
}

// ================================= Caja ====================================
// Nucleo del sistema. Reglas:
//   - Solo puede existir UNA sesion OPEN a la vez (configurable con env).
//   - Los movimientos solo se pueden registrar en sesiones OPEN (append-only).
//   - El cierre calcula: expected = opening + IN(CASH) - OUT(CASH).
//   - difference = counted - expected  (sobrante > 0, faltante < 0).
//   - Una sesion CLOSED es inmutable.
// ---------------------------------------------------------------------------

model CashSession {
  id              String    @id @default(cuid())
  companyId       String
  code            String
  status          String    @default("OPEN") // OPEN | CLOSED
  openedById      String
  openedAt        DateTime  @default(now())
  openingAmount   Int       @default(0) // Fondo inicial expresado en USD (moneda base)
  openingCurrency String    @default("USD") // Moneda en que se conto el fondo ("MIX" si fueron varias)
  openingRate     Float? // Bolivares por 1 unidad de `openingCurrency` (tasa usada)
  // Desglose del fondo cuando se conto en varias monedas a la vez, en JSON:
  // [{"currency":"USD","amount":100,"rate":900,"baseAmount":100}, ...].
  // Vacio = fondo de una sola moneda (`openingAmount`/`openingCurrency`).
  openingLines    String?
  openingNotes    String?
  closedById      String?
  closedAt        DateTime?
  countedAmount   Int? // Efectivo contado expresado en USD (moneda base)
  countedCurrency String? // Moneda en que se conto el efectivo al cerrar
  countedRate     Float? // Bolivares por 1 unidad de `countedCurrency` (tasa usada)
  expectedAmount  Int?
  difference      Int?
  closingNotes    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  company  Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  openedBy User    @relation("CashSessionOpenedBy", fields: [openedById], references: [id], onDelete: Restrict)
  closedBy User?   @relation("CashSessionClosedBy", fields: [closedById], references: [id], onDelete: SetNull)

  movements CashMovement[]
  orders    Order[]
  expenses  Expense[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([status])
  @@index([openedAt])
  @@map("cash_sessions")
}

model CashMovement {
  id            String   @id @default(cuid())
  companyId     String
  sessionId     String
  type          String // IN | OUT
  category      String // SALE | EXPENSE | WITHDRAWAL | DEPOSIT | REFUND | PAYMENT | ADJUSTMENT | OTHER
  paymentMethod String   @default("CASH") // CASH | CARD | TRANSFER | YAPE | PLIN
  amount        Int // Monto en la moneda del movimiento (`currency`)
  currency      String   @default("USD") // Moneda en que entro/salio el dinero
  exchangeRate  Float? // Bolivares por 1 unidad de `currency` (tasa usada)
  baseAmount    Int      @default(0) // Equivalente en USD (moneda base del sistema)
  description   String?
  referenceType String? // ORDER | EXPENSE | PAYABLE | RECEIVABLE | MANUAL
  referenceId   String?
  // Comprobante que respalda un cobro por transferencia/pago movil. Se copia
  // al movimiento para poder verlo desde la caja sin cruzar el pedido.
  paymentReference String?
  paymentPhotoUrl  String?
  createdById   String?
  createdAt     DateTime @default(now())

  company   Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  session   CashSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdBy User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([sessionId])
  @@index([createdAt])
  @@map("cash_movements")
}

// ============================== Configuracion ==============================
// Tabla clave/valor POR EMPRESA para ajustes del sistema que no merecen su
// propio modelo (por ahora: `rates.custom_usd`, la tasa personalizada Bs/USD
// del local, y `currencies.config`, las monedas que acepta cobrar/pagar). Lo
// que no esta aqui es lo *por defecto* (monedas por defecto, tasas del BCV),
// que es igual para todas las empresas.
model Setting {
  companyId   String
  key         String
  value       String
  updatedById String?
  updatedAt   DateTime @updatedAt

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  updatedBy User?   @relation("SettingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@id([companyId, key])
  @@map("settings")
}

// ========================== Notificaciones =================================
// Configuracion de avisos POR EMPRESA. El bot de Telegram es uno solo para todo
// el sistema (su token vive en `.env`); cada empresa vincula el chat privado de
// su administrador con un codigo temporal que el bot recibe por mensaje.
model NotificationSetting {
  companyId String @id

  // Interruptor general: sin el encendido no se envia ningun aviso.
  telegramEnabled Boolean @default(false)

  // Avisos disponibles (se pueden configurar antes de vincular Telegram).
  notifyLowStock      Boolean @default(true)
  notifySales         Boolean @default(true)
  notifyCashClose     Boolean @default(true)
  notifyCancellations Boolean @default(true)

  // Chat privado del administrador vinculado y su nombre en Telegram.
  telegramChatId    String?
  telegramChatTitle String?
  telegramLinkedAt  DateTime?

  // Codigo temporal que el administrador envia al bot (`/vincular CODIGO`).
  telegramLinkCode          String?
  telegramLinkCodeExpiresAt DateTime?

  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([telegramChatId])
  @@index([telegramLinkCode])
  @@map("notification_settings")
}

// Codigo de un solo uso para que un CAJERO pueda cancelar un pedido. Solo se
// guarda el hash: el codigo en claro viaja una vez por Telegram al administrador.
// `orderId`/`requestedById` quedan como texto para no duplicar relaciones; la
// empresa si es una relacion para limpiar los codigos si se elimina el tenant.
model CancellationOtp {
  id            String    @id @default(cuid())
  companyId     String
  orderId       String
  requestedById String?
  codeHash      String
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime  @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, orderId, usedAt])
  @@index([expiresAt])
  @@map("cancellation_otps")
}
